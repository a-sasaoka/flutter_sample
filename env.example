# ==============================================================================
# .env ファイルのテンプレート
# ==============================================================================
# このファイルを各環境に合わせてコピーして使用してください。
# 例: .env.local, .env.dev, .env.stg, .env.prod
# これらのファイルは Git 管理対象外 (.gitignore) となります。

# ------------------------------------------------------------------------------
# 🔒 1. 秘密情報・APIキー (AppEnv / Envied により難読化してビルド時に埋め込まれます)
# ------------------------------------------------------------------------------

# App Checkのデバッグ用トークン（Firebase Consoleから取得）
DEBUG_TOKEN=your_debug_token_here

# Google Maps API キー（Google Cloud Console から取得・ネイティブ Maps SDK 表示用）
MAPS_ANDROID_API_KEY=your_google_maps_android_api_key_here
MAPS_IOS_API_KEY=your_google_maps_ios_api_key_here


# ------------------------------------------------------------------------------
# 📱 2. ネイティブビルド設定 (iOS / Android のビルド時に使用されます)
# ------------------------------------------------------------------------------

# ios/Runner/Info.plist で使用される Google 逆クライアント ID
# Firebase コンソールからダウンロードした GoogleService-Info.plist の REVERSED_CLIENT_ID を入力してください。
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Links / Universal Links で使用するドメイン名（開発者個人のFirebaseプロジェクトドメイン等）
APP_LINK_DOMAIN=your-firebase-project-id.web.app

# ------------------------------------------------------------------------------
# 🛠 3. 個人環境オーバーライド設定 (--dart-define-from-file により優先上書きされます)
# ------------------------------------------------------------------------------
# チーム共通のデフォルト値は config/flavor_*.json で管理されています。
# 開発者個人の Firebase プロジェクト ID や、端末環境（Android / 実機）に合わせて上書きしたい場合のみ以下を指定してください。

# 例: API サーバー（Functions エミュレータ / モック）の個人環境用 URL
# - iOS シミュレータ / Web : http://localhost:5001/your-firebase-project-id/us-central1
# - Android エミュレータ   : http://10.0.2.2:5001/your-firebase-project-id/us-central1
# - 実機 (iOS / Android)   : http://192.168.x.x:5001/your-firebase-project-id/us-central1 (開発PCのLAN IP)
BASE_URL=http://localhost:5001/your-firebase-project-id/us-central1

# 例: Google Routes API サーバープロキシの個人環境用 URL
# - local / dev (iOS シミュレータ / Web) : http://localhost:5001/your-firebase-project-id/us-central1/computeRoutesProxy
# - local / dev (Android エミュレータ)   : http://10.0.2.2:5001/your-firebase-project-id/us-central1/computeRoutesProxy
# - local / dev (実機)                  : http://192.168.x.x:5001/your-firebase-project-id/us-central1/computeRoutesProxy
# - stg / prod                          : https://us-central1-your-firebase-project-id.cloudfunctions.net/computeRoutesProxy
GOOGLE_DIRECTIONS_API_URL=http://localhost:5001/your-firebase-project-id/us-central1/computeRoutesProxy

# 例: 個人の実験環境等でAIモデルやプロバイダーを上書きする場合
# AI_MODEL=gemini-3.5-flash-lite
# USE_AGENT_PLATFORM=false
