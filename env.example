# ==============================================================================
# .env ファイルのテンプレート
# ==============================================================================
# このファイルを各環境に合わせてコピーして使用してください。
# 例: .env.local, .env.dev, .env.stg, .env.prod
# これらのファイルは Git 管理対象外 (.gitignore) となります。

# ------------------------------------------------------------------------------
# 🔒 1. 秘密情報・APIキー (AppEnv / Envied により難読化してビルド時に埋め込まれます)
# ------------------------------------------------------------------------------

# App Checkのデバッグ用トークン（Firebase Consoleから取得）
DEBUG_TOKEN=your_debug_token_here

# ------------------------------------------------------------------------------
# 📱 2. ネイティブビルド設定 (iOS / Android のビルド時に使用されます)
# ------------------------------------------------------------------------------

# ios/Runner/Info.plist で使用される Google 逆クライアント ID
# Firebase コンソールからダウンロードした GoogleService-Info.plist の REVERSED_CLIENT_ID を入力してください。
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Links / Universal Links で使用するドメイン名（開発者個人のFirebaseプロジェクトドメイン等）
APP_LINK_DOMAIN=your-firebase-project-id.web.app

# ------------------------------------------------------------------------------
# 🛠 3. 個人環境オーバーライド設定 (--dart-define-from-file により優先上書きされます)
# ------------------------------------------------------------------------------
# チーム共通のデフォルト値は config/flavor_*.json で管理されています。
# 開発者個人のローカル環境や特定の接続先で上書きしたい場合のみ以下を指定してください。

# 例: ローカル Firebase エミュレータの個人プロジェクト用 URL
BASE_URL=http://localhost:5001/your-firebase-project-id/us-central1
